{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".turbo/**",
      ".vercel/**",
      ".cache/**",
      "tmp/**",
      "temp/**"
    ]
  },
  "permission": {
    "*": "ask",
    "external_directory": "ask",
    "doom_loop": "ask",
    "todowrite": "allow",
    "read": {
      "*": "allow",
      ".env*": "deny",
      "*.env*": "deny",
      "**/.env*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/secrets/**": "deny",
      "**/.ssh/**": "deny",
      "**/.gnupg/**": "deny",
      "**/auth.json": "deny",
      "**/service-account*.json": "deny",
      "**/*service-account*.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "task": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls*": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git clean -fdx*": "deny",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "npm run verify*": "allow",
      "npm run dev*": "ask",
      "npm run start*": "ask",
      "npm run deploy*": "ask",
      "npm run db*": "ask",
      "npm run supabase*": "ask",
      "npm run migrate*": "ask",
      "npm run migration*": "ask",
      "npm run seed*": "ask",
      "npm run reset*": "ask",
      "npm install*": "ask",
      "npm update*": "ask",
      "npm audit fix*": "ask",
      "npx *": "ask",
      "pnpm *": "ask",
      "bun *": "ask",
      "yarn *": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "rm *": "ask",
      "rm -rf*": "ask",
      "sudo*": "deny",
      "*|bash": "deny",
      "*| bash": "deny",
      "* | bash": "deny",
      "*|sh": "deny",
      "*| sh": "deny",
      "* | sh": "deny",
      "*>*": "ask",
      "*>>*": "ask"
    },
    "edit": {
      "*": "ask",
      "src/**/*.ts": "allow",
      "src/**/*.tsx": "allow",
      "src/**/*.js": "allow",
      "src/**/*.jsx": "allow",
      "src/**/*.css": "allow",
      "src/**/*.scss": "allow",
      "app/**/*.ts": "allow",
      "app/**/*.tsx": "allow",
      "components/**/*.ts": "allow",
      "components/**/*.tsx": "allow",
      "lib/**/*.ts": "allow",
      "tests/**/*.ts": "allow",
      "tests/**/*.tsx": "allow",
      "*.env*": "deny",
      ".env*": "deny",
      "**/.env*": "deny",
      "package.json": "deny",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "yarn.lock": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/secrets/**": "deny",
      "**/.ssh/**": "deny",
      "**/.gnupg/**": "deny",
      "**/auth.json": "deny",
      "**/service-account*.json": "deny",
      "**/*service-account*.json": "deny"
    }
  }
}
