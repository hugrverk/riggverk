{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riggverk",
  "version": "2026.10.14",
  "identifier": "se.hugrverk.riggverk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash scripts/prepare-macos-app-icon.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Riggverk",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 13,
          "y": 15
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/default-workspace/": "default-workspace/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Riggverk.icns": "macos/Riggverk.icns"
      },
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.14"
    }
  }
}
