{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riggverk",
  "version": "2026.11.11",
  "identifier": "se.hugrverk.riggverk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash scripts/prepare-macos-app-icon.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Riggverk",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": false,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Hugrverk",
    "copyright": "Copyright (c) 2026 Hugrverk",
    "category": "DeveloperTool",
    "homepage": "https://riggverk.se",
    "resources": {
      "../resources/default-workspace/": "default-workspace/",
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "macos/Riggverk.icon"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRUFCNjU2QkU5OTIyRjQKUldUMElwbStWcmJxbm1OUE8vWDg3OW1IZVlPZzJTRGZUV1U3Yis1WCsxNWduOUNCTE5KUmhwck0K",
      "endpoints": [
        "https://github.com/hugrverk/riggverk/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
