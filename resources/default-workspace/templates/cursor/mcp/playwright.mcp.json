{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--config",
        "__PLAYWRIGHT_MCP_CONFIG_PATH__",
        "--browser",
        "chrome",
        "--isolated",
        "--no-webmcp"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "__PLAYWRIGHT_BROWSERS_PATH__"
      }
    }
  }
}
