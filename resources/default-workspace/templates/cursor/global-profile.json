{
  "schema_version": "1.2",
  "id": "cursor-setup",
  "name": "Cursor Setup",
  "description": "Global Cursor setup for agents, starter skills, and Playwright MCP without project writes.",
  "setup_runtime": "native",
  "surfaces": {
    "agents": {
      "source_dir": "templates/cursor/agents",
      "target": "${HOME}/.cursor/agents",
      "writable": true
    },
    "skills": {
      "source_dir": "skills",
      "target": "${HOME}/.cursor/skills",
      "writable": true,
      "agent": "cursor",
      "scope": "global"
    },
    "mcp": {
      "template": "templates/cursor/mcp/playwright.mcp.json",
      "target": "${HOME}/.cursor/mcp.json",
      "writable": true,
      "merge_key": "mcpServers.playwright"
    }
  },
  "run_mode": {
    "recommended": "auto-review",
    "managed_by": "cursor-settings",
    "path": "Cursor Settings > Agents > Run Mode",
    "verifiable_by_agent_workspace": false
  },
  "project_writes": false,
  "excluded_targets": [
    ".cursor/mcp.json",
    ".cursor/rules",
    ".cursor/agents",
    ".cursor/skills",
    ".cursorignore",
    "AGENTS.md"
  ],
  "notes": [
    "Apply via the Agent Workspace Cursor page.",
    "Select Auto Review manually in Cursor Settings; Agent Workspace does not inspect undocumented Cursor state.",
    "Legacy permissions and sandbox profiles are no longer managed by Agent Workspace."
  ]
}
