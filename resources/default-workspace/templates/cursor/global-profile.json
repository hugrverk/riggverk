{
  "schema_version": "1.1",
  "id": "cursor-setup",
  "name": "Cursor Setup",
  "description": "Global Cursor setup for agents, starter skills, Playwright MCP, and Auto Review-compatible permissions without project writes.",
  "surfaces": {
    "agents": {
      "source_dir": "templates/cursor/agents",
      "target": "${HOME}/.cursor/agents",
      "writable": true
    },
    "skills": {
      "source_dir": "skills",
      "target": "${HOME}/.cursor/skills",
      "writable": true,
      "agent": "cursor",
      "scope": "global"
    },
    "mcp": {
      "template": "templates/cursor/mcp/playwright.mcp.json",
      "target": "${HOME}/.cursor/mcp.json",
      "writable": true,
      "merge_key": "mcpServers.playwright"
    },
    "permissions": {
      "template": "templates/cursor/permissions/global-playwright.json",
      "target": "${HOME}/.cursor/permissions.json",
      "writable": true
    }
  },
  "run_mode": {
    "recommended": "auto-review",
    "managed_by": "cursor-settings",
    "path": "Cursor Settings > Agents > Run Mode",
    "verifiable_by_agent_workspace": false
  },
  "project_writes": false,
  "excluded_targets": [
    ".cursor/mcp.json",
    ".cursor/rules",
    ".cursor/agents",
    ".cursor/skills",
    ".cursorignore",
    "AGENTS.md"
  ],
  "legacy_sandbox_profiles_dir": "templates/cursor/sandbox",
  "notes": [
    "Apply via scripts/install-cursor-workspace.sh --apply-global-profile.",
    "Diff via --diff-global-profile; validate via --validate-global-profile.",
    "Select Auto Review manually in Cursor Settings; Agent Workspace does not inspect undocumented Cursor state.",
    "Legacy sandbox JSON remains compatibility-only and is not exposed in the normal app workflow."
  ]
}
