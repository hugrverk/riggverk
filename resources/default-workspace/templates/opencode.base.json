{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "architect",
  "provider": {
    "opencode-go": {
      "models": {
        "qwen3.6-plus": {
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser=chrome"
      ],
      "enabled": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".turbo/**",
      ".vercel/**",
      ".cache/**",
      "tmp/**",
      "temp/**",
      "logs/**",
      "*.log",
      "vendor/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".vitest/**",
      "wordpress/wp-content/uploads/**",
      "wordpress/wp-content/cache/**",
      "wordpress/wp-content/upgrade/**",
      "wordpress/wp-content/debug.log"
    ]
  }
}
