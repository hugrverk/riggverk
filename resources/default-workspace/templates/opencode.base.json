{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "architect",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.48",
        "--config",
        "__PLAYWRIGHT_MCP_CONFIG_PATH__"
      ],
      "environment": {
        "PLAYWRIGHT_BROWSERS_PATH": "__PLAYWRIGHT_BROWSERS_PATH__"
      },
      "enabled": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".turbo/**",
      ".vercel/**",
      ".cache/**",
      "tmp/**",
      "temp/**",
      "logs/**",
      "*.log",
      "vendor/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".vitest/**",
      "wordpress/wp-content/uploads/**",
      "wordpress/wp-content/cache/**",
      "wordpress/wp-content/upgrade/**",
      "wordpress/wp-content/debug.log"
    ]
  }
}
