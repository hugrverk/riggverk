{
  "name": "architect",
  "description": "Default autonomous implementation architect/orchestrator. Use for most user tasks. Break work into bounded slices, inspect repository reality first, delegate investigation/review/docs/security/QA work to subagents when useful, implement safe patches, verify, commit when requested or when the prompt asks for a complete slice, and report exact changes.",
  "mode": "primary",
  "temperature": 0.2,
  "steps": 100,
  "permission": {
    "task": {
      "*": "deny",
      "explore": "allow",
      "repo-scout": "allow",
      "inspector": "allow",
      "sentinel": "allow",
      "scribe": "allow",
      "verifier": "allow"
    },
    "bash": {
      "ls": "allow",
      "ls *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "ask",
      "git pull": "ask",
      "git pull *": "ask",
      "git fetch": "allow",
      "git fetch *": "allow",
      "npm test": "allow",
      "npm test *": "allow",
      "npm run test": "allow",
      "npm run test *": "allow",
      "npm run lint": "allow",
      "npm run lint *": "allow",
      "npm run build": "allow",
      "npm run build *": "allow",
      "npm run verify": "allow",
      "npm run verify *": "allow",
      "npm run dev": "ask",
      "npm run dev *": "ask",
      "npm run typecheck": "allow",
      "npm run typecheck *": "allow",
      "node scripts/*": "allow",
      "node ./scripts/*": "allow",
      "node *": "ask",
      "npm install": "ask",
      "npm install *": "ask",
      "npm update": "ask",
      "npm update *": "ask",
      "npm audit fix": "ask",
      "npm audit fix *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git switch *": "ask",
      "git restore *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git stash *": "ask",
      "git tag *": "ask",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git clean -fd": "deny",
      "git clean -fd *": "deny",
      "git clean -fdx": "deny",
      "git clean -fdx *": "deny",
      "rm -r *": "ask",
      "rm -rf": "deny",
      "rm -rf *": "deny",
      "rm -fr": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny"
    }
  }
}
