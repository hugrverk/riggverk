{
  "command": "/bin/sh",
  "args": [
    "-c",
    "cd -- \"$1\" && shift && exec npx --prefix \"$0\" -y \"$@\"",
    "__PLAYWRIGHT_NPX_PREFIX_PATH__",
    "__PLAYWRIGHT_OUTPUT_PATH__",
    "@playwright/mcp@0.0.83",
    "--browser",
    "chrome",
    "--isolated",
    "--no-webmcp"
  ],
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "__PLAYWRIGHT_BROWSERS_PATH__"
  }
}
